# Optional private optimization sidecar. Without this setting the Edge Function
# keeps using its in-process assignment planner.
TIMEFOLD_SERVICE_URL=http://timefold:8080/api/assignments/solve
# Optional shared bearer token; configure the same value on the Timefold service.
TIMEFOLD_SERVICE_TOKEN=

# Must match the local/prod CRON_SECRET stored in Vault; never commit its value.
CRON_SECRET=

# Optional mobile push sender. Keep the Firebase service-account JSON only in
# infra/supabase/functions/.env (ignored) or Supabase Edge Function secrets.
FIREBASE_SERVICE_ACCOUNT_JSON=
