# Public Firebase app configuration only; obtain it by registering the Android
# and iOS bundle IDs in the Pollo Móvil Firebase project. Never put service
# account JSON or private keys in this file.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=com.pollomovil.mobile
